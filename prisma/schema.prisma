// ─────────────────────────────────────────────────────────────────────────────
// Banco do Assistente DETRAN (multi-tenant): um tenant por DETRAN.
// O "cérebro" de cada DETRAN é o bot dele no BotAyio (prompt, base e tutoria
// ficam lá). Aqui ficam o cadastro do tenant, as integrações, os usuários,
// os formulários, o balcão, os indicadores e o histórico das conversas.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  SUPERADMIN // equipe Ayio: todos os DETRANs
  ADMIN // administrador de um DETRAN
  GESTOR // painel e indicadores
  TUTOR // acesso à tutoria do bot (BotAyio)
  BALCAO // copiloto do balcão
}

enum Canal {
  WEB
  WHATSAPP
}

model Tenant {
  id           String   @id @default(cuid())
  slug         String   @unique @db.VarChar(20) // vai na URL: /pa, /am...
  uf           String   @db.Char(2)
  sigla        String   @db.VarChar(40) // "DETRAN-PA"
  nome         String   @db.VarChar(160) // "Departamento de Trânsito do Estado do Pará"
  governo      String   @db.VarChar(160) // "Governo do Estado do Pará"
  cidadeSede   String   @db.VarChar(80) // usada nos documentos ("Belém")
  assistente   String   @db.VarChar(80) // "Assistente DETRAN-PA"
  portalUrl    String   @db.VarChar(255)
  telefone     String   @db.VarChar(40) // call center
  logoUrl      String?  @db.VarChar(255)
  marcaUrl     String?  @db.VarChar(255)
  corPrimaria  String?  @db.VarChar(9) // cor de marca (topo, botões, balões)
  corDestaque  String?  @db.VarChar(9) // cor de destaque (enviar, realces, barras)
  // Demonstração: DETRAN ainda sem contrato -> faixa de aviso e fora do Google
  demonstracao Boolean  @default(true)
  // Jeito de falar com o cidadão (ex.: tom paraense). Vai nos prompts locais.
  personaTom   String?  @db.Text
  // Regras do estado: órgão do IPVA, multas por órgão, portais. Vai nos prompts.
  orientacoes  String?  @db.Text
  // Conteúdo da tela: sugestões, guias passo a passo, atalhos oficiais.
  conteudo     Json?
  ativo        Boolean  @default(true)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  integracao  TenantIntegracao?
  usuarios    Usuario[]
  formularios Formulario[]
  eventos     Evento[]
  balcao      AtendimentoBalcao[]
  conversas   Conversa[]
  migracoes   MigracaoLegado[]
  arquivos    TenantArquivo[]

  // Central de Gestão
  protocoloSeq     Int              @default(0) // último número de protocolo usado
  configGestao     Json? // horário, pesquisa de satisfação, categorias e prazos
  chamados         Chamado[]
  contatos         Contato[]
  respostasRapidas RespostaRapida[]
  etiquetas        Etiqueta[]
  lembretes        Lembrete[]
}

// Lembrete pelo WhatsApp (vencimento da CNH, prazo de defesa, licenciamento).
// Só é enviado depois que o dono do número confirma (responde SIM) ou quando
// ele mesmo pede pelo WhatsApp. status: PENDENTE | ATIVO | CONCLUIDO | CANCELADO
model Lembrete {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contato       String    @db.VarChar(20) // telefone com DDI (55...)
  tipo          String    @db.VarChar(20) // CNH | DEFESA | LICENCIAMENTO
  dataAlvo      DateTime // vencimento / prazo final
  descricao     String?   @db.VarChar(160) // ex.: "placa final 7"
  avisos        Json // dias antes do prazo em que avisa, ex.: [30, 7, 0]
  enviados      Json? // avisos já enviados
  status        String    @default("PENDENTE") @db.VarChar(12)
  origem        String    @db.VarChar(12) // SITE | WHATSAPP | BALCAO
  consentidoEm  DateTime? // quando o dono do número aceitou
  ultimoEnvioEm DateTime?
  criadoEm      DateTime  @default(now())

  @@index([tenantId, status, dataAlvo])
  @@index([tenantId, contato])
}

// Chamado com protocolo (ex.: PA-2026-000123), aberto pela equipe do DETRAN,
// em geral a partir de uma conversa.
model Chamado {
  id              String          @id @default(cuid())
  tenantId        String
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  numero          Int
  protocolo       String          @db.VarChar(30)
  conversaId      String?         @db.VarChar(30)
  canal           Canal?
  contato         String?         @db.VarChar(80)
  nome            String?         @db.VarChar(120)
  assunto         String          @db.VarChar(160)
  descricao       String?         @db.Text
  categoria       String?         @db.VarChar(60)
  prioridade      String          @default("NORMAL") @db.VarChar(10) // BAIXA | NORMAL | ALTA | URGENTE
  status          String          @default("ABERTO") @db.VarChar(20) // ABERTO | EM_ANDAMENTO | AGUARDANDO_CIDADAO | RESOLVIDO | CANCELADO
  responsavelId   String?         @db.VarChar(30)
  responsavelNome String?         @db.VarChar(120)
  prazoEm         DateTime?
  avisarCidadao   Boolean         @default(true)
  criadoPorNome   String?         @db.VarChar(120)
  criadoEm        DateTime        @default(now())
  atualizadoEm    DateTime        @updatedAt
  resolvidoEm     DateTime?
  eventos         ChamadoEvento[]

  @@unique([tenantId, numero])
  @@unique([tenantId, protocolo])
  @@index([tenantId, status, atualizadoEm])
  @@index([tenantId, contato])
}

// Linha do tempo do chamado. publico=true aparece para o cidadão.
model ChamadoEvento {
  id        String   @id @default(cuid())
  chamadoId String
  chamado   Chamado  @relation(fields: [chamadoId], references: [id], onDelete: Cascade)
  tipo      String   @db.VarChar(20) // ABERTURA | COMENTARIO | NOTA | STATUS | RESPONSAVEL | PRIORIDADE
  autorNome String?  @db.VarChar(120)
  texto     String   @db.Text
  publico   Boolean  @default(false)
  criadoEm  DateTime @default(now())

  @@index([chamadoId, criadoEm])
}

// Ficha do cidadão (por telefone ou sessão do site): etiquetas e anotações.
model Contato {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contato      String   @db.VarChar(80)
  nome         String?  @db.VarChar(120)
  notas        String?  @db.Text
  etiquetas    Json? // [idEtiqueta, ...]
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([tenantId, contato])
}

model RespostaRapida {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  atalho   String @db.VarChar(40) // usado com "/" na caixa de resposta
  titulo   String @db.VarChar(120)
  texto    String @db.Text
  ordem    Int    @default(0)

  @@unique([tenantId, atalho])
}

model Etiqueta {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome     String @db.VarChar(40)
  cor      String @db.VarChar(9)

  @@unique([tenantId, nome])
}

// Identidade visual guardada no próprio banco (logo, marca pequena).
model TenantArquivo {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo         String   @db.VarChar(20) // logo | marca
  mime         String   @db.VarChar(40)
  dados        Bytes    @db.MediumBlob
  atualizadoEm DateTime @updatedAt

  @@unique([tenantId, tipo])
}

// Registro das etapas já migradas do sistema antigo (Redis/arquivos), para a
// migração poder rodar de novo sem duplicar nada.
model MigracaoLegado {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  etapa       String   @db.VarChar(40) // eventos | balcao | conhecimento
  total       Int      @default(0)
  detalhe     String?  @db.Text
  executadaEm DateTime @default(now())

  @@unique([tenantId, etapa])
}

// Credenciais por DETRAN. Tudo que termina em "Enc" é criptografado (AES-GCM)
// com a chave APP_ENCRYPTION_KEY do servidor.
model TenantIntegracao {
  id                 String   @id @default(cuid())
  tenantId           String   @unique
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  // BotAyio: webhook síncrono do bot deste DETRAN (/webhooks/seucartorio/<bot_id>)
  botayioUrl         String?  @db.VarChar(255)
  botayioSecretEnc   String?  @db.Text
  // Link de tutoria do bot (/tutor/app?bot=...&token=...) - tem token, então é cifrado
  botayioTutorUrlEnc String?  @db.Text
  // Zapayio (OnZap): mesma estrutura de rotas da Z-API
  zapayioBaseUrl     String?  @db.VarChar(255)
  zapayioInstanceId  String?  @db.VarChar(120)
  zapayioTokenEnc    String?  @db.Text
  zapayioClientEnc   String?  @db.Text
  // Segredo do caminho do webhook: /api/t/<slug>/zapayio/webhook/<segredo>
  zapayioWebhookEnc  String?  @db.Text
  atualizadoEm       DateTime @updatedAt
}

model Usuario {
  id           String    @id @default(cuid())
  tenantId     String? // nulo só para SUPERADMIN
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome         String    @db.VarChar(120)
  login        String    @db.VarChar(120)
  senhaHash    String    @db.VarChar(255)
  perfil       Perfil
  ativo        Boolean   @default(true)
  ultimoAcesso DateTime?
  criadoEm     DateTime  @default(now())
  // Central de Gestão: ONLINE | PAUSA | OFFLINE (para a fila e a equipe)
  statusAtendimento String    @default("OFFLINE") @db.VarChar(12)
  statusEm          DateTime?

  @@unique([tenantId, login])
  @@index([login])
}

model Formulario {
  id        String  @id @default(cuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chave     String  @db.VarChar(60) // "procuracao", "comunicacao-venda"...
  ordem     Int     @default(0)
  definicao Json // { id, title, subtitle, desc, sections: [...] }
  ativo     Boolean @default(true)

  @@unique([tenantId, chave])
}

// Indicadores do painel. tipo: PERGUNTA | FEEDBACK
model Evento {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo       String   @db.VarChar(20)
  canal      Canal    @default(WEB)
  tema       String?  @db.VarChar(60)
  resolvido  Boolean?
  positivo   Boolean?
  transbordo Boolean  @default(false)
  criadoEm   DateTime @default(now())

  @@index([tenantId, criadoEm])
}

model AtendimentoBalcao {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  usuarioId String?
  guiche    String?  @db.VarChar(40)
  atendente String?  @db.VarChar(60)
  servico   String?  @db.VarChar(120)
  cidadao   String?  @db.VarChar(80)
  cpf       String?  @db.VarChar(20)
  protocolo String?  @db.VarChar(40)
  resumo    String?  @db.Text
  criadoEm  DateTime @default(now())

  @@index([tenantId, criadoEm])
}

// Histórico por DETRAN (site e WhatsApp). status: BOT | HUMANO | ENCERRADA
model Conversa {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  canal      Canal
  contato    String     @db.VarChar(80) // telefone (WhatsApp) ou id da sessão (site)
  nome       String?    @db.VarChar(120)
  status     String     @default("BOT") @db.VarChar(12)
  categoria  String?    @db.VarChar(60)
  // Atendimento humano (transbordo): quem assumiu e quando
  atendenteId   String?   @db.VarChar(30)
  atendenteNome String?   @db.VarChar(120)
  transbordoEm  DateTime?
  // Indicadores da Central de Gestão
  primeiraRespostaEm DateTime? // 1ª resposta humana depois do transbordo
  encerradaEm        DateTime?
  avaliacao          Int? // 1 a 5 (pesquisa de satisfação)
  avaliacaoPendente  Boolean   @default(false)
  iniciadaEm DateTime   @default(now())
  ultimaEm   DateTime   @default(now())
  mensagens  Mensagem[]

  @@unique([tenantId, canal, contato])
  @@index([tenantId, ultimaEm])
  @@index([tenantId, status, ultimaEm])
}

model Mensagem {
  id         String   @id @default(cuid())
  conversaId String
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  autor      String   @db.VarChar(12) // CIDADAO | BOT | ATENDENTE | SISTEMA
  autorNome  String?  @db.VarChar(120) // nome do atendente
  texto      String   @db.Text
  criadoEm   DateTime @default(now())

  @@index([conversaId, criadoEm])
}
