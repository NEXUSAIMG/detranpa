# ─────────────────────────────────────────────────────────────
# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o Git.
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
# Deixe TUDO vazio aqui: valores de verdade só no .env / na Vercel.
# ─────────────────────────────────────────────────────────────

# ── Banco (MySQL no Railway) ─────────────────────────────────
# Na Vercel (serverless), limite as conexões por função:
#   mysql://USUARIO:SENHA@HOST:PORTA/BANCO?connection_limit=3
DATABASE_URL=

# ── Segurança ────────────────────────────────────────────────
# Chave que cifra os segredos das integrações no banco (32 bytes).
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ATENÇÃO: se trocar, os segredos já gravados deixam de abrir.
APP_ENCRYPTION_KEY=
# Assina os logins das áreas internas (mínimo 32 caracteres aleatórios).
AUTH_SECRET=

# ── Multi-tenant ─────────────────────────────────────────────
# DETRAN para onde vão os endereços antigos ("/", "/tutor", "/balcao")
DEFAULT_TENANT=pa
# URL pública do app (links de documento no WhatsApp e webhook do Zapayio)
PUBLIC_URL=

# ── IA local (fotos, formulários, defesa, balcão e plano B) ──
# O cérebro de cada DETRAN é o bot dele no BotAyio; esta IA cobre o resto.
# "deepseek" (padrão) ou "anthropic".
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# deepseek-v4-pro NÃO lê imagens; para fotos de documentos use deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_THINKING=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
MAX_TOKENS=2048

# ── Estado curto do WhatsApp (Upstash / Vercel KV) ───────────
# Mensagens já processadas e sessão por telefone. Sem isso, fica em memória.
KV_REST_API_URL=
KV_REST_API_TOKEN=
WHATSAPP_SESSAO_HORAS=12
BOTAYIO_TIMEOUT_MS=25000

# As credenciais do BotAyio e do Zapayio são POR DETRAN e ficam no banco
# (cifradas). Cadastre com:  npm run tenant -- integracao <slug>

# Porta do servidor local (opcional)
PORT=3000

# --- Segurança e desempenho (22/11/2026) ---
# Perfis com verificação em duas etapas OBRIGATÓRIA (aplicativo autenticador). Ex.: SUPERADMIN,ADMIN,GESTOR
EXIGIR_2FA=
# Cache das perguntas frequentes (1ª pergunta, sem dados pessoais, 6 h). 0 desliga.
CACHE_RESPOSTAS=1
