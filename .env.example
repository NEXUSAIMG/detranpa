# ─────────────────────────────────────────────────────────────
# Copie este arquivo para ".env" e preencha a sua chave.
# O arquivo .env NÃO deve ir para o Git (já está no .gitignore).
# ─────────────────────────────────────────────────────────────

# ── Provedor de IA ───────────────────────────────────────────
# "deepseek" (padrão) ou "anthropic". Se ficar vazio, o servidor usa o
# provedor cuja chave estiver preenchida (DeepSeek tem prioridade).
LLM_PROVIDER=deepseek

# Chave da API da DeepSeek (gere em https://platform.deepseek.com/api_keys)
# (deixe VAZIO aqui; a chave de verdade vai só no .env)
DEEPSEEK_API_KEY=

# Modelo DeepSeek (opcional). Padrão: deepseek-flash
# ATENÇÃO: deepseek-v4-pro NÃO lê imagens — a análise de fotos de
# documentos (multa, CNH, CRLV) só funciona com deepseek-flash.
DEEPSEEK_MODEL=deepseek-flash

# Raciocínio ("thinking") do DeepSeek: 1 liga, vazio desliga (padrão).
# Ligado fica mais lento e mais caro.
DEEPSEEK_THINKING=

# ── Alternativa: Anthropic (só se LLM_PROVIDER=anthropic) ────
# Chave em https://console.anthropic.com/settings/keys (deixe VAZIO aqui)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Máximo de tokens por resposta (opcional)
MAX_TOKENS=2048

# Porta do servidor (opcional)
PORT=3000
